<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SanadPay - Professional Invoice Platform</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="container">
      <h1>💳 SanadPay</h1>
      <nav>
        <a href="/login">Login</a>
        <a href="/signup" class="btn btn-primary">Sign Up</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h2>Professional Invoice Platform</h2>
      <p>Create professional invoices easily and get a payment link with QR code instantly</p>
      <a href="/signup" class="btn btn-primary">Get Started</a>
    </section>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin: 60px 0;">
      <div style="background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border);">
        <h3 style="color: var(--primary); margin-bottom: 12px;">📝 Create Invoice</h3>
        <p style="color: var(--text-light);">Enter customer details, amount, and description easily</p>
      </div>

      <div style="background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border);">
        <h3 style="color: var(--accent); margin-bottom: 12px;">🔗 Instant Payment Link</h3>
        <p style="color: var(--text-light);">Get a payment link and QR code for your customer immediately</p>
      </div>

      <div style="background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border);">
        <h3 style="color: var(--success); margin-bottom: 12px;">📄 Auto PDF</h3>
        <p style="color: var(--text-light);">Get a PDF invoice automatically after payment is received</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2024 SanadPay - All Rights Reserved</p>
    </div>
  </footer>
</body>
</html>
