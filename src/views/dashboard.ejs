<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>لوحة التحكم - SanadPay</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="container">
      <h1><a href="/" style="color: inherit; text-decoration: none;">💳 SanadPay</a></h1>
      <nav>
        <a href="/logout">خروج</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <div class="dashboard-header">
      <h2>مرحباً <%= user.owner_name %></h2>
      <p style="color: var(--text-muted);"><%=user.business_name %></p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 32px; margin: 32px 0;">
      <!-- Create Invoice Form -->
      <div>
        <div style="background: var(--surface); padding: 24px; border-radius: 12px; border: 1px solid var(--border); position: sticky; top: 80px;">
          <h3 style="margin-bottom: 20px;">إنشاء فاتورة جديدة</h3>

          <form id="createInvoiceForm">
            <div class="form-group">
              <label>اسم العميل</label>
              <input type="text" name="customer_name" required>
            </div>

            <div class="form-group">
              <label>بريد العميل (اختياري)</label>
              <input type="email" name="customer_email">
            </div>

            <div class="form-group">
              <label>المبلغ (ريال)</label>
              <input type="number" name="amount" step="0.01" required>
            </div>

            <div class="form-group">
              <label>الوصف</label>
              <textarea name="description" rows="3" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">إنشاء فاتورة</button>
          </form>
        </div>
      </div>

      <!-- Invoice List -->
      <div>
        <h3 style="margin-bottom: 20px;">فواتيري</h3>
        <div id="invoicesList" style="display: flex; flex-direction: column; gap: 12px;">
          <p style="color: var(--text-muted);">جاري التحميل...</p>
        </div>
      </div>
    </div>
  </main>

  <script>
    // Create Invoice
    document.getElementById('createInvoiceForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);

      try {
        const res = await fetch('/api/invoices/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await res.json();
        if (result.success) {
          showInvoiceModal(result);
          e.target.reset();
          loadInvoices();
        } else {
          alert(result.error);
        }
      } catch (err) {
        alert('خطأ في إنشاء الفاتورة');
      }
    });

    // Load Invoices
    async function loadInvoices() {
      try {
        const res = await fetch('/api/invoices/list');
        const data = await res.json();
        const container = document.getElementById('invoicesList');

        if (data.invoices.length === 0) {
          container.innerHTML = '<p style="color: var(--text-muted);">لا توجد فواتير بعد</p>';
          return;
        }

        container.innerHTML = data.invoices.map(inv => `
          <div class="invoice-card">
            <div class="invoice-card-header">
              <div>
                <div class="invoice-card-title">${inv.customer_name}</div>
                <div class="invoice-card-info">${inv.invoice_number}</div>
              </div>
              <div class="invoice-card-status status-${inv.status}">
                ${inv.status === 'paid' ? 'مدفوعة' : 'قيد الانتظار'}
              </div>
            </div>
            <div class="invoice-card-amount">${inv.amount} ريال</div>
            <p style="color: var(--text-light); margin-bottom: 12px;">${inv.description}</p>
            ${inv.status === 'paid' ? `<a href="/api/payments/invoice/${inv.invoice_number}/pdf" class="btn btn-secondary" style="display: inline-block;">تحميل PDF</a>` : ''}
          </div>
        `).join('');
      } catch (err) {
        console.error(err);
      }
    }

    function showInvoiceModal(data) {
      const modal = `
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); display: flex; align-items: center; justify-content: center; z-index: 1000;">
          <div style="background: var(--surface); padding: 40px; border-radius: 12px; max-width: 500px; border: 1px solid var(--border); text-align: center;">
            <h2 style="margin-bottom: 20px;">✅ تم إنشاء الفاتورة</h2>

            <p style="color: var(--text-muted); margin-bottom: 20px;">شارك الرابط أو QR code مع العميل</p>

            <div style="background: white; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
              <img src="${data.qr_code}" style="max-width: 100%; height: auto;">
            </div>

            <div style="background: var(--bg); padding: 12px; border-radius: 6px; word-break: break-all; margin-bottom: 20px; font-size: 12px;">
              ${data.payment_url}
            </div>

            <button onclick="navigator.clipboard.writeText('${data.payment_url}'); alert('تم النسخ!');" class="btn btn-primary" style="width: 100%;">نسخ الرابط</button>

            <button onclick="location.reload();" class="btn btn-secondary" style="width: 100%; margin-top: 12px;">إغلاق</button>
          </div>
        </div>
      `;
      document.body.insertAdjacentHTML('beforeend', modal);
    }

    loadInvoices();
  </script>
</body>
</html>
