{
  "$schema": "https://railway.json.sh",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm cache clean --force && npm ci --legacy-peer-deps --no-audit --no-fund"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "healthchecks": {
      "enabled": false
    }
  },
  "nixpacks": {
    "providers": ["nodejs-npm"],
    "nixpkgsVersion": "nixpkgs-23.11"
  }
}
