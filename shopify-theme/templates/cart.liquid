<div class="simple-page">
  <h1>Your cart</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <span>{{ item.product.title }}</span>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
          <span>{{ item.final_line_price | money }}</span>
        </div>
      {%- endfor -%}
      <p class="cart-total">Total: <strong>{{ cart.total_price | money }}</strong></p>
      <button type="submit" name="update" class="link-btn">Update</button>
      <button type="submit" name="checkout" class="buy-btn">Checkout</button>
    </form>
  {%- else -%}
    <p>Your cart is empty.</p>
    <a href="{{ routes.root_url }}" class="link-btn">Continue shopping</a>
  {%- endif -%}
</div>
