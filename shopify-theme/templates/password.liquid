{% layout 'password' %}
<div class="simple-page">
  <h1>{{ shop.name }}</h1>
  <p>Opening soon.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Password" aria-label="Password">
    <button type="submit" class="link-btn">Enter</button>
  {%- endform -%}
</div>
