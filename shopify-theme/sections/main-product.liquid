{%- liquid
  if product
    assign p = product
  elsif section.settings.product != blank
    assign p = section.settings.product
  else
    assign p = collections.all.products.first
  endif
  assign variant = p.selected_or_first_available_variant
-%}

<div class="product">
  <section class="gallery">
    <div class="main-image">
      {%- if p.featured_image -%}
        {{ p.featured_image | image_url: width: 1000 | image_tag: alt: p.title, loading: 'eager', widths: '400, 600, 800, 1000', sizes: '(max-width: 760px) 320px, 380px' }}
      {%- else -%}
        <img src="{{ 'product.jpg' | asset_url }}" alt="{{ p.title | default: 'Product' | escape }}" width="1000" height="1000">
      {%- endif -%}
    </div>
  </section>

  <section class="details">
    {%- if section.settings.tag != blank -%}
      <span class="tag">{{ section.settings.tag }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: p.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="price">
      <span class="amount">{{ variant.price | default: p.price | money }}</span>
      {%- if variant.compare_at_price > variant.price -%}
        <s class="compare">{{ variant.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
    {%- if section.settings.shipping_note != blank -%}
      <p class="shipping-note">{{ section.settings.shipping_note }}</p>
    {%- endif -%}

    <div class="buy-form">
      {%- if p == blank or variant == blank -%}
        <p class="shipping-note">Select a product for this section in the theme editor.</p>
      {%- elsif variant.available -%}
        {%- comment -%} Cart permalink: skips the cart and opens checkout (address + payment) directly {%- endcomment -%}
        <a href="{{ routes.cart_url }}/{{ variant.id }}:1" class="buy-btn">{{ section.settings.button_label }}</a>
      {%- else -%}
        <button type="button" class="buy-btn" disabled>Sold out</button>
      {%- endif -%}
    </div>
    {%- if section.settings.secure_note != blank -%}
      <p class="secure">🔒 {{ section.settings.secure_note }}</p>
    {%- endif -%}

    {%- assign features = section.blocks | where: 'type', 'feature' -%}
    {%- if features.size > 0 -%}
      <ul class="features">
        {%- for block in features -%}
          <li {{ block.shopify_attributes }}><span class="icon">{{ block.settings.icon }}</span>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.ingredients != blank -%}
      <div class="ingredients">
        <h2>{{ section.settings.ingredients_heading }}</h2>
        <div class="chips">
          {%- assign items = section.settings.ingredients | split: ',' -%}
          {%- for item in items -%}
            <span>{{ item | strip }}</span>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (home page)", "info": "On product pages the current product is used." },
    { "type": "text", "id": "tag", "label": "Tag", "default": "For Men & Women" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the product title.", "default": "Underarm Odor Control Mist" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Glycolic Acid 7% · Fragrance Free · 100 ml" },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Delivery across the UAE" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy Now" },
    { "type": "text", "id": "secure_note", "label": "Secure payment note", "default": "Safe & secure checkout" },
    { "type": "text", "id": "ingredients_heading", "label": "Ingredients heading", "default": "Key Ingredients" },
    { "type": "textarea", "id": "ingredients", "label": "Ingredients (comma separated)", "default": "Glycolic Acid 7%, Hyaluronic Acid, Ceramides, Allantoin, Gotu Kola Extract" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or short text)", "default": "✦" },
        { "type": "text", "id": "text", "label": "Text", "default": "Feature" }
      ]
    }
  ],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
